# Public Warehouses Search
GET http://localhost:8081/v1/public/warehouses?q=central&near=0.0236,37.9062&radius_km=30

###
# Public Warehouse Detail
GET http://localhost:8081/v1/public/warehouses/{{WAREHOUSE_ID}}

###
# Public Products Search
GET http://localhost:8081/v1/public/products?q=bolt&near=0.0236,37.9062&radius_km=50

###
# Public Product Detail
GET http://localhost:8081/v1/public/products/{{INVENTORY_ID}}

###
# Public Transport Search by kind + capacity + proximity
GET http://localhost:8081/v1/public/transport?q=van&min_capacity_kg=500&near=0.0236,37.9062&radius_km=40

###
# Vehicle Tracking (authenticated)
POST http://localhost:8081/v1/vehicles/{{VEHICLE_ID}}/track
Content-Type: application/json
Authorization: Bearer {{JWT}}

{ "lat": 0.033, "lng": 37.002 }

###
# Device Ingest (single)
POST http://localhost:8081/v1/ingest/telemetry
X-Device-Id: {{DEVICE_ID}}
X-Device-Token: {{DEVICE_TOKEN}}
Content-Type: application/json

{ "lat": 0.034, "lng": 37.003 }

###
# Device Ingest (batch)
POST http://localhost:8081/v1/ingest/telemetry
X-Device-Id: {{DEVICE_ID}}
X-Device-Token: {{DEVICE_TOKEN}}
Content-Type: application/json

{ "data": [
  { "lat": 0.034, "lng": 37.003, "ts": "2025-01-01T10:00:00Z"},
  { "lat": 0.035, "lng": 37.004, "ts": "2025-01-01T10:00:05Z"}
]}

###
# Assets
POST http://localhost:8081/v1/assets
Content-Type: application/json
Authorization: Bearer {{JWT}}

{ "kind": "container", "name": "CMA CGM 123", "identifier": "CMAU1234567" }

###
GET http://localhost:8081/v1/assets
Authorization: Bearer {{JWT}}

###
POST http://localhost:8081/v1/assets/{{ASSET_ID}}/track
Content-Type: application/json
Authorization: Bearer {{JWT}}

{ "lat": 0.036, "lng": 37.005 }

###
POST http://localhost:8081/v1/assets/{{ASSET_ID}}/devices
Content-Type: application/json
Authorization: Bearer {{JWT}}

{ "name": "Tracker-01", "kind": "teltonika", "serial": "T1234" }

###
POST http://localhost:8081/v1/assets/{{ASSET_ID}}/assign
Content-Type: application/json
Authorization: Bearer {{JWT}}

{ "vehicleId": "{{VEHICLE_ID}}" }
###
# Deliveries: enable public tracking (returns tracking code)
POST http://localhost:8081/v1/deliveries/{{DELIVERY_ID}}/public-tracking
Content-Type: application/json
Authorization: Bearer {{JWT}}

{ "enabled": true }

###
# Public: Track by code (no auth)
GET http://localhost:8081/v1/public/track/{{TRACKING_CODE}}
###
# Orders
POST http://localhost:8081/v1/orders
Authorization: Bearer {{JWT}}

###
GET http://localhost:8081/v1/orders/{{ORDER_ID}}
Authorization: Bearer {{JWT}}

###
# Shipments
POST http://localhost:8081/v1/shipments
Authorization: Bearer {{JWT}}
Content-Type: application/json

{ "orderId": "{{ORDER_ID}}", "vehicleId": "{{VEHICLE_ID}}", "route": [ { "address": "Origin Address" }, { "address": "Destination Address" } ] }

###
GET http://localhost:8081/v1/shipments/{{SHIPMENT_ID}}/track
Authorization: Bearer {{JWT}}

###
POST http://localhost:8081/v1/shipments/{{SHIPMENT_ID}}/route
Authorization: Bearer {{JWT}}
Content-Type: application/json

{ "address": "Intermediate Stop" }

###
# Proof of Delivery
POST http://localhost:8081/v1/deliveries/{{SHIPMENT_ID}}/complete
Authorization: Bearer {{JWT}}
Content-Type: application/json

{ "signedBy": "Receiver Name", "photoUrl": "https://example.com/pod.jpg" }
###
# Transport Jobs
# List posted jobs
GET http://localhost:8081/v1/transport/jobs
Authorization: Bearer {{JWT}}

###
# List my jobs (assigned)
GET http://localhost:8081/v1/transport/jobs?mine=1
Authorization: Bearer {{JWT}}

###
# Create job
POST http://localhost:8081/v1/transport/jobs
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "pickupAddress": "Factory A, City",
  "deliveryAddress": "Retailer B, City",
  "cargoDesc": "10 pallets of goods",
  "vehicleKind": "truck",
  "capacityKg": 5000,
  "payment": 250.00,
  "currency": "USD"
}

###
# Assign job (driver accepts)
PUT http://localhost:8081/v1/transport/jobs/{{JOB_ID}}/assign
Authorization: Bearer {{JWT}}
Content-Type: application/json

{ "vehicleId": "{{VEHICLE_ID}}" }

###
# Job tracking (driver)
POST http://localhost:8081/v1/transport/jobs/{{JOB_ID}}/tracking
Authorization: Bearer {{JWT}}
Content-Type: application/json

{ "lat": 0.045, "lng": 37.015 }

###
# Complete job
POST http://localhost:8081/v1/transport/jobs/{{JOB_ID}}/complete
Authorization: Bearer {{JWT}}
