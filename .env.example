# Logistics service env
APP_NAME=berjis-logistics
APP_ENV=development
PORT=8081

# Service DB (domain-specific)
DATABASE_URL="{user}:{pass}@tcp(logistics-db:3306)/berjis_logistics?parseTime=true&multiStatements=true"

# API base for systemwide operations
CORE_API_BASE=http://api:8080

ALLOWED_ORIGINS=http://localhost:4300,https://logistics.berjis.tech
