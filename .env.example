# Logistics service env
APP_NAME=berjis-logistics
APP_ENV=development
PORT=8081

# Service DB (domain-specific) - PostgreSQL DSN
DATABASE_URL="postgres://postgres:postgres@logistics-db:5432/berjis_logistics?sslmode=disable"

# API base for systemwide operations
CORE_API_BASE=http://api:8080

ALLOWED_ORIGINS=http://localhost:4300,https://logistics.berjis.tech,https://logistics-admin.berjis.tech

# Auth: verify Authorization: Bearer <jwt> with HS256 secret (dev/local)
AUTH_JWT_HS256_SECRET=change-me-dev-only
